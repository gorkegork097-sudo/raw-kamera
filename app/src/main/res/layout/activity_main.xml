<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Vizör: 3:4 canlı görüntü + ızgara -->
    <com.rawkamera.AspectFrameLayout
        android:id="@+id/previewBox"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center">

        <TextureView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.rawkamera.GridOverlay
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </com.rawkamera.AspectFrameLayout>

    <!-- Üst bilgi satırı: histogram, ISO, ENS, EV, RAW -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="44dp"
        android:paddingEnd="20dp">

        <com.rawkamera.HistogramView
            android:id="@+id/histogram"
            android:layout_width="96dp"
            android:layout_height="40dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/isoBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">
                <TextView android:id="@+id/isoLabel" style="@style/HudLabel"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="ISO" />
                <TextView android:id="@+id/isoValue" style="@style/HudValue"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="400" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/shBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">
                <TextView android:id="@+id/shLabel" style="@style/HudLabel"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="ENS" />
                <TextView android:id="@+id/shValue" style="@style/HudValue"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="1/125" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">
                <TextView style="@style/HudLabel"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="EV" />
                <TextView android:id="@+id/evValue" style="@style/HudValue"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0.0" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/raw_tag"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.12"
            android:paddingStart="5dp"
            android:paddingTop="2dp"
            android:paddingEnd="5dp"
            android:paddingBottom="2dp"
            android:text="RAW"
            android:textColor="#FFFFFF"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- Desteklenmiyor / izin yok mesajı -->
    <TextView
        android:id="@+id/message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:lineSpacingMultiplier="1.3"
        android:padding="32dp"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:visibility="gone" />

    <!-- Alt kısım: ayar menüsü + deklanşör -->
    <LinearLayout
        android:id="@+id/bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#000000"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/menuPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#FFFFFF" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingTop="12dp"
                android:paddingEnd="20dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/menuLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif"
                    android:letterSpacing="0.2"
                    android:text="ISO"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/menuValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:text="400"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp" />
            </LinearLayout>

            <com.rawkamera.RulerView
                android:id="@+id/ruler"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:textColor="#9A9A9A"
            android:textSize="10sp" />

        <!-- Dokunma alanı sadece görünen çubuk kadar geniş -->
        <FrameLayout
            android:id="@+id/shutter"
            android:layout_width="140dp"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="28dp"
            android:clickable="true"
            android:contentDescription="Fotoğraf çek"
            android:focusable="true">

            <View
                android:id="@+id/shutterBar"
                android:layout_width="140dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:background="@drawable/shutter_bar" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
